---
import "@fontsource-variable/inter";
import { Image, getImage } from "astro:assets";
import icon from "../../../assets/icon.png";
import Demo from "../components/Demo.astro";

const repo = "https://github.com/dinogomez/runecast";
const description =
  "A fast, free and open-source launcher for macOS and Linux. Open apps, find files, do math, convert units and manage windows from your keyboard.";
const favicon = await getImage({ src: icon, width: 64, format: "png" });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Runecast</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#161616" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <script is:inline>
      // Before first paint, so the page never flashes the other theme: the visitor's choice, else
      // the system's.
      document.documentElement.dataset.theme =
        localStorage.getItem("theme") ?? (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Runecast" />
    <meta property="og:title" content="Runecast" />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Runecast" />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/png" href={favicon.src} />
  </head>
  <body>
    <nav class="corner">
      <button class="theme" type="button" aria-label="Switch to light theme">
        <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></g></svg>
        <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/></svg>
      </button>
      <a class="github" href={repo} aria-label="Runecast on GitHub">
        <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"/></svg>
      </a>
    </nav>
    <main>
      <section class="hero">
        <Image src={icon} alt="" width={128} height={128} densities={[1, 2]} class="icon" loading="eager" />
        <h1>Runecast</h1>
        <p class="tagline">
          Press <kbd>⌥</kbd><kbd>Space</kbd>, type a few letters, hit <kbd>↩</kbd>.
        </p>
        <div class="actions">
          <a class="button" href={`${repo}/releases/latest`}>
            <svg viewBox="0 0 384 512" width="15" height="18" aria-hidden="true"><path fill="currentColor" d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9m-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3"/></svg>
            Download for macOS
          </a>
        </div>
      </section>

      <Demo />
    </main>

    <footer>
      Built with <a href="https://github.com/anomalyco/rune">Rune</a> · <a href={repo}>MIT License</a>
    </footer>

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>(".theme")!;
      const label = () =>
        toggle.setAttribute("aria-label", `Switch to ${root.dataset.theme === "dark" ? "light" : "dark"} theme`);
      label();
      toggle.addEventListener("click", () => {
        root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
        localStorage.setItem("theme", root.dataset.theme);
        label();
      });
      // Until the visitor picks one, the page follows the system as it changes.
      matchMedia("(prefers-color-scheme: light)").addEventListener("change", (e) => {
        if (localStorage.getItem("theme")) return;
        root.dataset.theme = e.matches ? "light" : "dark";
        label();
      });
    </script>

    <style is:global>
      :root {
        --bg: #161616;
        --text: #ededed;
        --muted: #8a8a8a;
        --line: #2e2e2e;
        --surface: #1f1f1f;
        --arrow: url("/cursors/arrow.svg") 6 4, default;
        --pointer: url("/cursors/pointer.svg") 10 4, pointer;
        color-scheme: dark;
      }

      :root[data-theme="light"] {
        --bg: #fafafa;
        --text: #161616;
        --muted: #6b6b6b;
        --line: #e2e2e2;
        --surface: #fff;
        color-scheme: light;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        cursor: var(--arrow);
      }

      a,
      button,
      a *,
      button * {
        cursor: var(--pointer);
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Inter Variable", system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
      }
    </style>

    <style>
      main {
        max-width: 860px;
        margin: 0 auto;
        padding: 96px 24px 64px;
      }

      .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .icon {
        width: 128px;
        height: 128px;
      }

      .corner {
        position: absolute;
        top: 24px;
        right: 28px;
        display: flex;
        gap: 18px;
        align-items: center;
      }

      .github,
      .theme {
        display: flex;
        padding: 0;
        border: 0;
        background: none;
        color: var(--muted);
        transition: color 0.15s;
      }

      .github:hover,
      .theme:hover {
        color: var(--text);
      }

      /* The button shows the theme it switches to. */
      :global([data-theme="dark"]) .moon,
      :global([data-theme="light"]) .sun {
        display: none;
      }

      h1 {
        margin: 20px 0 0;
        font-size: 56px;
        font-weight: 400;
        letter-spacing: -0.03em;
        line-height: 1.1;
      }

      .tagline {
        margin: 14px 0 0;
        font-size: 20px;
        letter-spacing: -0.01em;
        color: var(--muted);
      }

      kbd {
        display: inline-block;
        min-width: 1.6em;
        margin: 0 2px;
        padding: 1px 6px;
        border: 1px solid var(--line);
        border-bottom-width: 2px;
        border-radius: 6px;
        background: var(--surface);
        color: var(--text);
        font: inherit;
        font-size: 15px;
      }

      .actions {
        display: flex;
        gap: 10px;
        margin-top: 32px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 20px;
        border-radius: 999px;
        background: var(--text);
        color: var(--bg);
        font-size: 15px;
        font-weight: 500;
        text-decoration: none;
        transition: transform 0.15s;
      }

      .button svg {
        margin-top: -2px;
      }

      .button:hover {
        transform: translateY(-1px);
      }

      footer {
        padding: 32px 24px 48px;
        text-align: center;
        font-size: 13px;
        color: var(--muted);
      }
    </style>
  </body>
</html>
